# TargetP 2.0 in a private Apptainer image. The DTU licence forbids sharing TargetP, so the image is for its licensee only.
# Build and use: see the README section "SignalP and TargetP".

Bootstrap: docker
From: condaforge/miniforge3:26.7.2-0

%files
    {{ TARGETP_DIR }} /opt/targetp-2.0

%post
    set -eu
    cat > /opt/targetp.env.yml << 'EOF'
name: targetp
channels:
  - conda-forge
  - bioconda
  - nodefaults
dependencies:
  - _openmp_mutex=4.5=20_gnu
  - biopython=1.88=py314h89acca1_1
  - bzip2=1.0.8=hda65f42_10
  - ca-certificates=2026.7.22=hbd8a1cb_0
  - ld_impl_linux-64=2.46.1=default_hbd61a6d_102
  - libblas=3.11.0=11_h4a7cf45_openblas
  - libcblas=3.11.0=11_h0358290_openblas
  - libexpat=2.8.5=hd2095e1_0
  - libffi=3.7.0=h81df57d_1
  - libgcc=16.2.0=ha9f2e26_7
  - libgfortran=16.2.0=h69a702a_7
  - libgfortran5=16.2.0=h6b99dfc_7
  - libgomp=16.2.0=he0feb66_7
  - liblapack=3.11.0=11_h47877c9_openblas
  - liblzma=5.8.3=hb03c661_1
  - libmpdec=4.0.0=hb03c661_2
  - libopenblas=0.3.34=pthreads_hf13c14d_2
  - libpython=3.14.8=hdc7f604_101_cp314
  - libsqlite=3.53.4=h0737f62_103
  - libstdcxx=16.2.0=h934c35e_7
  - libuuid=2.42.4=hcfc3c73_0
  - libzlib=1.3.2=h25fd6f3_3
  - ncurses=6.6=hdb14827_1
  - numpy=2.5.3=py314hd3a7d6b_0
  - openssl=3.6.5=h781a0a9_0
  - pip=26.2.1=pyh145f28c_0
  - python=3.14.8=hcd007b5_101_cp314
  - python_abi=3.14=9_cp314
  - readline=8.3=hd6e31c0_1
  - tk=8.6.13=noxft_h1df4ec4_4
  - tzdata=2026c=h151e31d_0
  - zstd=1.5.7=hb78ec9c_7
EOF
    conda env create --prefix /opt/env --file /opt/targetp.env.yml
    rm /opt/targetp.env.yml
    conda clean --all --yes

%environment
    export PATH=/opt/targetp-2.0/bin:/opt/env/bin:$PATH
    export PYTHONNOUSERSITE=1

%test
    command -v targetp

%labels
    Description TargetP 2.0, private image under the DTU licence
