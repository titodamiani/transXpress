# transXpress. Run from the clone: snakemake --profile profiles/<site> -d runs/<name> (README.md "Running transXpress")

# The image with the conda env of every rule (Dockerfile, built by image.yml). A change to an env file or to the
# Dockerfile needs another tag here (CONTRIBUTING.md "The main image").
MAIN_IMAGE = "docker://ghcr.io/titodamiani/transxpress:1.0.0"
containerized: MAIN_IMAGE

include: "rules/common.smk"
include: "rules/databases.smk"
include: "rules/trim.smk"
include: "rules/qc.smk"
include: "rules/assembly.smk"
include: "rules/orfs.smk"
include: "rules/expression.smk"
include: "rules/annotation.smk"

# The default target has to be a rule of this file: Snakemake does not take the first rule of an included file.
rule all:
  """
  List of target files of the transxpress pipeline.
  """
  input:
    "results/trimmomatic/samples_trimmed.txt",
    "results/summary/transcriptome.fasta",
    expand("results/summary/transcriptome_{orf_set}.pep", orf_set=["all_orfs", "single_best_orf"]),
    expand("results/transdecoder/transcriptome_all_orfs.{ext}", ext=["pep", "cds", "gff3", "bed"]),
    expand("results/transdecoder/transcriptome_single_best_orf.{ext}", ext=["pep", "cds", "gff3", "bed"]),
    "results/summary/transcriptome_stats.txt",
    "results/qc/assembly/transcriptome_exN50_tmm.pdf",
    "results/summary/transcriptome_annotated.fasta",
    expand("results/summary/transcriptome_{orf_set}_annotated.pep", orf_set=["all_orfs", "single_best_orf"]),
    "results/summary/busco_report.txt",
    "results/qc/multiqc/before_trim/multiqc_fastqc.txt",
    "results/qc/multiqc/after_trim/multiqc_fastqc.txt",
    "results/qc/fastqc/WARNING_fastqc_before_trim_overview.txt",
    "results/qc/fastqc/FastQC_comparison_after_trim.txt",
    "results/expression/edger",
    "results/summary/run_info.txt"

# Every job gets its temporary folder from job_tmpdir, which Snakemake evaluates inside the job, where the scratch
# variable is set. A tmpdir from --set-resources stays.
for workflow_rule in workflow.rules:
  if "tmpdir" not in workflow_rule.resources:
    workflow_rule.resources["tmpdir"] = job_tmpdir
  # A rule without a conda env runs in the main env, outside the image.
  if workflow_rule.is_containerized and not workflow_rule.conda_env:
    workflow_rule.container_img = None
    workflow_rule.is_containerized = False
