# transXpress: RNA-Seq de novo assembly and annotation. Run it in a run folder that holds config.yaml and a
# samples file: snakemake --snakefile ../workflow/Snakefile

# The image that holds the conda env of every rule, built from the Dockerfile at the top of the repository by
# .github/workflows/image.yml. A run with --software-deployment-method conda apptainer takes the rule envs from
# it, and a run with conda alone builds them from the pin files in envs/. A change to an env file needs a new
# Dockerfile and a new tag here.
MAIN_IMAGE = "docker://ghcr.io/titodamiani/transxpress:1.0.0"
containerized: MAIN_IMAGE

include: "rules/common.smk"
include: "rules/databases.smk"
include: "rules/trim.smk"
include: "rules/qc.smk"
include: "rules/assembly.smk"
include: "rules/orfs.smk"
include: "rules/expression.smk"
include: "rules/annotation.smk"

# The default target has to be a rule of this file: Snakemake does not take the first rule of an included file.
rule all:
  """
  List of target files of the transxpress pipeline.
  """
  input:
    "results/trimmomatic/samples_trimmed.txt",
    "results/assembly/transcriptome.fasta",
    "results/transdecoder/transcriptome.pep",
    expand("results/transdecoder/transcriptome_all_orfs.{ext}", ext=["pep", "cds", "gff3", "bed"]),
    expand("results/transdecoder/transcriptome_single_best_orf.{ext}", ext=["pep", "cds", "gff3", "bed"]),
    "results/qc/assembly/transcriptome_stats.txt",
    "results/qc/assembly/ExN50_plot.pdf",
    "results/annotation/transcriptome_annotated.fasta",
    "results/annotation/transcriptome_annotated.pep",
    "results/annotation/transcriptome_TPM_blast.csv",
    "results/qc/assembly/busco",
    "results/qc/assembly/busco/busco_report.txt",
    "results/qc/fastqc/before_trim",
    "results/qc/multiqc/before_trim",
    "results/qc/fastqc/after_trim",
    "results/qc/multiqc/after_trim",
    "results/qc/multiqc/before_trim/multiqc_fastqc.txt",
    "results/qc/multiqc/after_trim/multiqc_fastqc.txt",
    "results/qc/fastqc/WARNING_fastqc_before_trim_overview.txt",
    "results/qc/fastqc/FastQC_comparison_after_trim.txt",
    "results/expression/edger",
    "results/run_info.txt"

# Every job gets its temporary folder (TMPDIR, TMP and TEMP) from job_tmpdir, so the temporary files of
# the tools go to the node's local disk when the scratch key is set. Snakemake evaluates the tmpdir
# resource inside the job, where the variable is set. A tmpdir value of --set-resources is already in
# the rule at this point, and it stays.
for workflow_rule in workflow.rules:
  if "tmpdir" not in workflow_rule.resources:
    workflow_rule.resources["tmpdir"] = job_tmpdir
  # A rule without a conda env runs in the main env, outside the image. Its tools and Python packages come
  # from that env, and a script: rule loads the snakemake package of that env, which needs its Python.
  if workflow_rule.is_containerized and not workflow_rule.conda_env:
    workflow_rule.container_img = None
    workflow_rule.is_containerized = False
